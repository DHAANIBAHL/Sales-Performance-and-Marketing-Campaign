# STEP 6d — TOP SARIMA CANDIDATES
def calc_mape(actual, predicted):
    actual = np.array(actual)
    predicted = np.array(predicted)
    return np.mean(np.abs((actual - predicted) / actual)) * 100

top_candidates = trustworthy_df.head(5)
